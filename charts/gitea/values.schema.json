{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "gitea wrapper values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "gitea": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "http": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
                }
              }
            },
            "ssh": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
                }
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["host"],
                "properties": {
                  "host": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "storageClass": { "type": "string" }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "tag": { "type": "string" },
            "rootless": { "type": "boolean" }
          }
        },
        "podSecurityContext": {
          "type": "object",
          "additionalProperties": true
        },
        "containerSecurityContext": {
          "type": "object",
          "additionalProperties": true
        },
        "gitea": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "admin": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "description": "Secret used by upstream chart for bootstrap/admin credentials."
                }
              }
            },
            "additionalConfigFromEnvs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string"
                  },
                  "valueFrom": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true,
                "oneOf": [
                  { "required": ["value"] },
                  { "required": ["valueFrom"] }
                ]
              }
            },
            "additionalConfigSources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "secret": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["secretName"],
                    "properties": {
                      "secretName": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
