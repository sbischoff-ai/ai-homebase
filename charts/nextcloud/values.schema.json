{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "nextcloud values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"],
          "description": "Kubernetes Service type for Nextcloud exposure."
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string",
          "default": "/"
        },
        "pathType": {
          "type": "string",
          "default": "Prefix"
        },
        "private": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "host": {
              "type": "string",
              "description": "Private ingress hostname for Nextcloud."
            }
          }
        },
        "public": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "host": {
              "type": "string",
              "description": "Public ingress hostname for Nextcloud."
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "storageClass": {
          "type": "string",
          "description": "PVC storageClass override for Nextcloud data."
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "description": "Optional envFrom Secret for Nextcloud runtime configuration."
    },
    "secretRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "key", "envVar"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "envVar": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "trustedProxies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "user": {
          "type": "string"
        },
        "secure": {
          "type": "string"
        },
        "authType": {
          "type": "string"
        },
        "fromAddress": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      }
    },
    "skeletonDirectory": {
      "type": "string",
      "description": "Nextcloud system skeletondirectory value. Empty string disables example-file seeding for newly created users."
    },
    "bootstrapApps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bootstrapProjectContent": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "ownerUsername"],
        "additionalProperties": true,
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "ownerUsername": {
            "type": "string",
            "minLength": 1
          },
          "projectsFiles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "additionalProperties": true,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "projectsFilesDir": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "additionalProperties": true,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "notesFilesDir": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
