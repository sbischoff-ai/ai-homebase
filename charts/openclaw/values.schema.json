{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "openclaw values",
  "additionalProperties": true,
  "required": ["image", "service", "ingress", "persistence"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "default": "IfNotPresent"
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "targetPort"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"],
          "default": "ClusterIP",
          "description": "Kubernetes Service type for OpenClaw."
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "minLength": 1 }
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "hosts"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "className": { "type": "string", "default": "" },
        "defaultHost": {
          "type": "string",
          "default": "openclaw.example.com",
          "description": "Fallback host when a hosts[*].host entry is omitted."
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": {
                "type": "string",
                "description": "Ingress hostname for OpenClaw; empty allows fallback to ingress.defaultHost/global host."
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "size"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "size": { "type": "string", "default": "10Gi" },
        "storageClass": {
          "type": "string",
          "default": "",
          "description": "PVC storageClass override for OpenClaw state."
        },
        "existingClaim": { "type": "string", "default": "" },
        "hostPath": {
          "type": "string",
          "default": "",
          "description": "Optional hostPath source to mount instead of using a PVC when OpenClaw state must be shared with a remote Docker host."
        }
      }
    },
    "remoteDocker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the standard SSH-backed remote Docker access path for OpenClaw sandboxing."
        },
        "dockerHost": {
          "type": "string",
          "default": "ssh://docker-remote@openclaw-sandbox:2222",
          "description": "Value exported as DOCKER_HOST for the standard remote Docker sandbox host."
        },
        "home": {
          "type": "string",
          "default": "/home/node",
          "description": "Value exported as HOME so the Docker SSH transport can find mounted keys."
        },
        "cli": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Install a Docker CLI into the OpenClaw pod via init container instead of assuming the app image includes it."
            },
            "installPath": {
              "type": "string",
              "default": "/opt/openclaw-tools/bin",
              "description": "Directory added to PATH for the injected Docker CLI binary."
            },
            "image": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "repository": { "type": "string", "default": "docker" },
                "tag": { "type": "string", "default": "28.0.4-cli" },
                "pullPolicy": {
                  "type": "string",
                  "enum": ["Always", "IfNotPresent", "Never"],
                  "default": "IfNotPresent"
                }
              }
            }
          }
        },
        "ssh": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "secretName": {
              "type": "string",
              "default": "openclaw-remote-docker-ssh",
              "description": "Secret containing at least a private key file and known_hosts."
            },
            "mountPath": {
              "type": "string",
              "default": "/home/node/.ssh",
              "description": "Target path where the prepared SSH directory is mounted in the container."
            }
          }
        }
      }
    },
    "qdrant": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "url": {
          "type": "string",
          "default": "",
          "description": "Gateway Qdrant REST URL for archivist-only graph grooming scripts. Empty uses the in-cluster release service URL."
        },
        "collectionName": {
          "type": "string",
          "default": "openclaw-memory",
          "description": "Qdrant collection used by the shared memory system."
        },
        "apiKeySecret": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string", "default": "" },
            "key": { "type": "string", "default": "QDRANT_API_KEY" }
          }
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "default": "openclaw-secrets",
      "description": "Secret used for explicit key mapping via secretKeys.*."
    },
    "secretRefs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "key", "envVar"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "envVar": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "openclaw": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tools": {
          "type": "object",
          "additionalProperties": true
        },
        "cron": {
          "type": "object",
          "default": {},
          "additionalProperties": true
        },
        "skills": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "allowBundled": {
              "type": "array",
              "default": [],
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "trustedProxies": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "defaults": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "sandbox": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "backend": { "type": "string", "default": "docker" },
                    "mode": { "type": "string", "default": "non-main" },
                    "scope": { "type": "string", "default": "agent" },
                    "workspaceAccess": {
                      "type": "string",
                      "enum": ["none", "ro", "rw"],
                      "default": "rw"
                    },
                    "docker": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "image": { "type": "string", "default": "registry.example.com/coder/openclaw-sandbox:trixie-slim" },
                        "workdir": { "type": "string", "default": "/workspace" },
                        "readOnlyRoot": { "type": "boolean", "default": true },
                        "tmpfs": {
                          "type": "array",
                          "default": ["/tmp", "/var/tmp", "/run"],
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "binds": {
                          "type": "array",
                          "default": [],
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "user": { "type": "string", "default": "1000:1000" },
                        "capDrop": {
                          "type": "array",
                          "default": ["ALL"],
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "pidsLimit": { "type": "integer", "minimum": 1, "default": 256 },
                        "memory": { "type": "string", "default": "1g" },
                        "memorySwap": { "type": "string", "default": "2g" },
                        "cpus": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
                        "network": { "type": "string", "default": "bridge" }
                      }
                    },
                    "browser": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "enabled": { "type": "boolean", "default": true },
                        "image": { "type": "string", "default": "openclaw-sandbox-browser:bookworm-slim" },
                        "network": { "type": "string", "default": "bridge" },
                        "cdpPort": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 9222 },
                        "vncPort": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 5900 },
                        "noVncPort": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 6080 },
                        "headless": { "type": "boolean", "default": false },
                        "enableNoVnc": { "type": "boolean", "default": true },
                        "cdpSourceRange": {
                          "type": "string",
                          "default": "",
                          "description": "CIDR range allowed to reach the remote browser sandbox CDP endpoint."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": true
        },
        "mcp": {
          "type": "object",
          "additionalProperties": true
        },
        "plugins": {
          "type": "object",
          "additionalProperties": true,
          "description": "Structured OpenClaw plugin configuration rendered into openclaw.json."
        }
      }
    }
  }
}
