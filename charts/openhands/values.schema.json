{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "openhands values",
  "additionalProperties": true,
  "required": [
    "image",
    "service",
    "ingress",
    "persistence"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "default": "IfNotPresent"
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "enabled",
        "type",
        "port",
        "targetPort"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ],
          "default": "ClusterIP",
          "description": "Kubernetes Service type for OpenHands."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "hostName"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "hostName": {
          "type": "string",
          "default": "",
          "description": "Primary ingress host for OpenHands."
        },
        "ingressClassName": {
          "type": "string",
          "default": ""
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "enabled",
        "size"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "size": {
          "type": "string",
          "default": "20Gi"
        },
        "storageClass": {
          "type": "string",
          "default": "",
          "description": "PVC storageClass override for OpenHands workspace."
        },
        "existingClaim": {
          "type": "string",
          "default": ""
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "default": "",
      "description": "Optional envFrom Secret name for OpenHands runtime credentials."
    },
    "secretRefs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "name",
          "key",
          "envVar"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "envVar": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "secretEnv": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "name",
          "secretName",
          "key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": true
      }
    },
    "hostDockerSocket": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Mount the host Docker socket into OpenHands for Docker-backed sandboxing."
        },
        "hostPath": {
          "type": "string",
          "default": "/var/run/docker.sock",
          "description": "Host path for the Docker socket mounted into the pod."
        },
        "mountPath": {
          "type": "string",
          "default": "/var/run/docker.sock",
          "description": "Container path where the Docker socket is mounted."
        }
      }
    }
  }
}
