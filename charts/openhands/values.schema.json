{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "openhands values",
  "additionalProperties": true,
  "required": [
    "image",
    "service",
    "ingress",
    "persistence"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "default": "IfNotPresent"
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "enabled",
        "type",
        "port",
        "targetPort"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ],
          "default": "ClusterIP",
          "description": "Kubernetes Service type for OpenHands."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "hostName"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "hostName": {
          "type": "string",
          "default": "",
          "description": "Primary ingress host for OpenHands."
        },
        "ingressClassName": {
          "type": "string",
          "default": ""
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "enabled",
        "size"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "size": {
          "type": "string",
          "default": "20Gi"
        },
        "storageClass": {
          "type": "string",
          "default": "",
          "description": "PVC storageClass override for OpenHands workspace."
        },
        "existingClaim": {
          "type": "string",
          "default": ""
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "default": "",
      "description": "Optional envFrom Secret name for OpenHands runtime credentials."
    },
    "secretRefs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "name",
          "key",
          "envVar"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "envVar": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "secretEnv": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "name",
          "secretName",
          "key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": true
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": {
          "type": "boolean",
          "default": true
        },
        "automountServiceAccountToken": {
          "type": "boolean",
          "default": true
        },
        "name": {
          "type": "string",
          "default": ""
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string",
          "default": "kubernetes",
          "enum": [
            "kubernetes"
          ],
          "description": "OpenHands runtime mode rendered into config.toml."
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "namespace": {
          "type": "string",
          "default": "",
          "description": "Namespace for OpenHands-created runtime resources."
        },
        "ingress_domain": {
          "type": "string",
          "default": "",
          "description": "Base domain used for per-session runtime ingress hosts."
        },
        "pvc_storage_size": {
          "type": "string",
          "default": "2Gi"
        },
        "pvc_storage_class": {
          "type": "string",
          "default": ""
        },
        "resource_cpu_request": {
          "type": "string",
          "default": "1"
        },
        "resource_memory_request": {
          "type": "string",
          "default": "1Gi"
        },
        "resource_memory_limit": {
          "type": "string",
          "default": "2Gi"
        },
        "image_pull_secret": {
          "type": "string",
          "default": ""
        },
        "ingress_tls_secret": {
          "type": "string",
          "default": ""
        },
        "node_selector_key": {
          "type": "string",
          "default": ""
        },
        "node_selector_val": {
          "type": "string",
          "default": ""
        },
        "tolerations_yaml": {
          "type": "string",
          "default": ""
        },
        "privileged": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
