{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "postfix-relay values",
  "additionalProperties": true,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allowedSenderDomains": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "mynetworks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
