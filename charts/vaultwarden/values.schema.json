{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "vaultwarden values",
  "additionalProperties": true,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path",
                    "pathType"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "databaseUrlSecret": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "key"
      ]
    },
    "existingSecret": {
      "type": "string"
    },
    "secretRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "envVar": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "key",
          "envVar"
        ]
      }
    },
    "appConfig": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "domain": {
          "type": "string"
        },
        "signupsAllowed": {
          "type": "boolean",
          "default": false
        },
        "invitationsAllowed": {
          "type": "boolean",
          "default": true
        },
        "websocketEnabled": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
