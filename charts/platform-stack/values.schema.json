{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "platform-stack values",
  "additionalProperties": true,
  "required": [
    "global",
    "certManager",
    "openclaw",
    "sharedPostgresql"
  ],
  "properties": {
    "certManager": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "resourcesEnabled": {
          "type": "boolean",
          "default": false
        },
        "resourceNamespace": {
          "type": "string",
          "default": ""
        },
        "internalCA": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "selfSignedClusterIssuerName": {
              "type": "string",
              "minLength": 1
            },
            "caClusterIssuerName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "openclawCertificate": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "description": "Shared conventions applied across subcharts.",
      "required": [
        "domain",
        "hosts"
      ],
      "additionalProperties": true,
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/nameOrLocalRef"
          }
        },
        "storageClass": {
          "type": "string",
          "default": "",
          "description": "Default StorageClass used when a service-specific storageClass is not set."
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "default": "homebase.local",
          "description": "Base domain used by host-based values and overlays."
        },
        "hosts": {
          "type": "object",
          "description": "Default hostnames by service.",
          "additionalProperties": {
            "$ref": "#/definitions/hostname"
          },
          "properties": {
            "openclaw": {
              "$ref": "#/definitions/hostname"
            },
            "nextcloud": {
              "$ref": "#/definitions/hostname"
            },
            "gitea": {
              "$ref": "#/definitions/hostname"
            },
            "argocd": {
              "$ref": "#/definitions/hostname"
            },
            "paperlessNgx": {
              "$ref": "#/definitions/hostname"
            },
            "vaultwarden": {
              "$ref": "#/definitions/hostname"
            },
            "infisical": {
              "$ref": "#/definitions/hostname"
            }
          }
        }
      }
    },
    "openclaw": {
      "type": "object",
      "required": [
        "enabled",
        "service",
        "ingress"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "existingSecret": {
          "type": "string",
          "default": "openclaw-app-secrets",
          "description": "Kubernetes Secret name containing OpenClaw credentials."
        },
        "remoteDocker": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "dockerHost": {
              "type": "string",
              "default": "ssh://docker-remote@openclaw-sandbox:2222"
            },
            "home": {
              "type": "string",
              "default": "/home/node"
            },
            "ssh": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "secretName": {
                  "type": "string",
                  "default": "openclaw-remote-docker-ssh"
                },
                "mountPath": {
                  "type": "string",
                  "default": "/home/node/.ssh"
                }
              }
            }
          }
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "ingress": {
          "$ref": "#/definitions/ingressWithHosts"
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "secretRefs": {
          "$ref": "#/definitions/secretRefs"
        },
        "secretKeys": {
          "$ref": "#/definitions/openclawSecretKeys"
        }
      }
    },
    "nextcloud": {
      "$ref": "#/definitions/optionalServiceToggle"
    },
    "gitea": {
      "$ref": "#/definitions/optionalServiceToggle"
    },
    "argoCd": {
      "$ref": "#/definitions/optionalServiceToggle"
    },
    "paperlessNgx": {
      "$ref": "#/definitions/optionalServiceToggle"
    },
    "vaultwarden": {
      "$ref": "#/definitions/optionalServiceToggle"
    },
    "infisical": {
      "$ref": "#/definitions/optionalServiceToggle"
    },
    "sharedPostgresql": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "fullnameOverride": {
          "type": "string",
          "default": "platform-stack-shared-postgresql"
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "registry": {
                  "type": "string",
                  "default": "docker.io"
                },
                "repository": {
                  "type": "string",
                  "default": "postgres"
                },
                "tag": {
                  "type": "string",
                  "default": "17.5-alpine"
                },
                "pullPolicy": {
                  "type": "string",
                  "default": "IfNotPresent"
                }
              }
            }
          }
        }
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "externalSecrets"
        ]
      },
      {
        "required": [
          "observability"
        ]
      },
      {
        "required": [
          "persistence"
        ]
      },
      {
        "required": [
          "autoscaling"
        ]
      },
      {
        "required": [
          "workerIsolation"
        ]
      }
    ]
  },
  "definitions": {
    "nameOrLocalRef": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": true
        }
      ]
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$",
      "description": "DNS host name.",
      "default": "example.homebase.local"
    },
    "service": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ],
          "default": "ClusterIP",
          "description": "Kubernetes Service type."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "ingressWithHosts": {
      "type": "object",
      "required": [
        "enabled",
        "hosts"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "className": {
          "type": "string",
          "default": ""
        },
        "hosts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "$ref": "#/definitions/hostname"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "size": {
          "type": "string",
          "default": "10Gi",
          "description": "PersistentVolumeClaim requested storage size."
        },
        "storageClass": {
          "type": "string",
          "default": "",
          "description": "PVC StorageClass override for this service."
        }
      }
    },
    "secretRefs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "name",
          "key",
          "envVar"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "envVar": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "optionalServiceToggle": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "openclawSecretKeys": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gatewayToken": {
          "type": "string",
          "default": "OPENCLAW_GATEWAY_TOKEN"
        },
        "openaiApiKey": {
          "type": "string",
          "default": ""
        },
        "anthropicApiKey": {
          "type": "string",
          "default": ""
        },
        "braveApiKey": {
          "type": "string",
          "default": ""
        },
        "kimiApiKey": {
          "type": "string",
          "default": ""
        },
        "moonshotApiKey": {
          "type": "string",
          "default": ""
        },
        "tavilyApiKey": {
          "type": "string",
          "default": ""
        },
        "perplexityApiKey": {
          "type": "string",
          "default": ""
        },
        "geminiApiKey": {
          "type": "string",
          "default": ""
        },
        "xaiApiKey": {
          "type": "string",
          "default": ""
        },
        "googleApiKey": {
          "type": "string",
          "default": ""
        },
        "braveSearchApiKey": {
          "type": "string",
          "default": ""
        }
      }
    }
  }
}
